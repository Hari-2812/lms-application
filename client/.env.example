# Origin of the Express backend. Leave unset for local dev — the Vite proxy in
# vite.config.js forwards /api to http://localhost:5000.
#
# Set this in the Vercel project's Environment Variables for a split deploy.
# No trailing slash. Whatever you put here must also appear in the backend's
# CLIENT_URL (as the frontend's own origin) or CORS will block the browser.
#
# VITE_API_URL=https://lms-demo-api.onrender.com
