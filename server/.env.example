PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/lms_demo

# --- Google Drive (private video source) ----------------------------------
# Preferred: path to the service-account JSON you downloaded from Google Cloud.
# Relative paths resolve against the server/ directory. The file is gitignored.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=credentials/service-account.json

# The Drive folder holding the lesson videos. Share that folder with the
# service account's client_email (Viewer) — do NOT make it "anyone with link".
# The id is the last path segment of the folder URL:
#   https://drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=

# Alternative to the key file — only use these if you cannot store a file.
# GOOGLE_PRIVATE_KEY must be one line with literal \n escapes, in quotes.
# GOOGLE_PROJECT_ID=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Extra allowed browser origins, comma-separated. Not needed for local dev —
# any http://localhost:<port> is accepted automatically, so it does not matter
# which port Vite lands on. Required in production (NODE_ENV=production), where
# only these exact origins are allowed.
# CLIENT_URL=https://app.example.com,https://admin.example.com

# --- Emailed links (password reset) ------------------------------------
# The frontend address used in emailed links. Falls back to the first
# CLIENT_URL entry, then http://localhost:5173. Never taken from the request.
# APP_URL=https://app.example.com

# --- Outgoing email -------------------------------------------------------
# Normally configured in Admin -> LMS settings -> Email. These are a fallback.
# Without either, password reset links are printed to this server's console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
