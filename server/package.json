{
  "name": "lms-demo-server",
  "version": "1.0.0",
  "private": true,
  "description": "LMS MVP demo backend - private Google Drive video streaming through Node.js",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch src/index.js",
